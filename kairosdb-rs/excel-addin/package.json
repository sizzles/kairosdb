{
  "name": "kairosdb-rs-excel-addin",
  "version": "1.0.0",
  "description": "Excel custom functions for kairosdb-rs (server-side aggregated time-series queries)",
  "license": "Apache-2.0",
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "start": "office-addin-debugging start manifest.xml",
    "stop": "office-addin-debugging stop manifest.xml",
    "watch": "webpack --mode development --watch",
    "validate": "office-addin-manifest validate manifest.xml"
  },
  "dependencies": {
    "core-js": "^3.36.0"
  },
  "devDependencies": {
    "@types/custom-functions-runtime": "^1.0.6",
    "@types/office-js": "^1.0.377",
    "copy-webpack-plugin": "^12.0.2",
    "custom-functions-metadata-plugin": "^2.0.5",
    "html-webpack-plugin": "^5.6.0",
    "office-addin-cli": "^2.0.0",
    "office-addin-debugging": "^6.0.0",
    "office-addin-dev-certs": "^2.0.0",
    "office-addin-manifest": "^2.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.0"
  }
}
